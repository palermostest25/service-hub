[Unit]
Description=Local Service Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=servicehub
Group=servicehub
WorkingDirectory=/opt/service-hub
Environment=DATA_DIR=/opt/service-hub/data
Environment=PORT=1000
ExecStart=/usr/bin/python3 /opt/service-hub/server.py
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/service-hub/data

[Install]
WantedBy=multi-user.target
